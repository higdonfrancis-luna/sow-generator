C3.5 classify():
function classify(q){
  // the firm's own answers first: 'your team and their Adobe certifications' is about the firm, not the product
  if(FIRM.test(q))return 'firm';
  if(ADOBE.test(q))return 'adobe';
  if(WORK.test(q))return 'adobe';
  return 'unsure';
}

